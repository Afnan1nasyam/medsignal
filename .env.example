# MedSignal Environment Variables

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
PRIMARY_MODEL=llama-3.1-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=BioLORD-2023-C

# Graph Store Backend ("networkx" for dev, "neo4j" for prod)
GRAPH_BACKEND=networkx

# Neo4j (only needed if GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Paths
DATA_DIR=data
QDRANT_PATH=data/qdrant
GRAPH_PATH=data/knowledge_graph.json
SQLITE_PATH=data/medsignal.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Rate Limiting
GROQ_RPM=30
GROQ_RETRY_ATTEMPTS=3

# Retrieval Settings
VECTOR_TOP_K=10
GRAPH_MAX_HOPS=3
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Agent Settings
AGENT_MAX_ITERATIONS=3
AGENT_MIN_EVIDENCE_PIECES=3

# External APIs (for data fetching scripts — run on personal laptop)
OPENFDA_API_KEY=
NCBI_API_KEY=
